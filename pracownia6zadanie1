        "#####"],
    3: ["#### ",
        "    #",
        " ### ",
        "    #",
        "#### "],
    4: ["   # ",
        "  ## ",
        " # # ",
        "#####",
        "   # "],
    5: ["#####",
        "#    ",
        "#### ",
        "    #",
        "#### "],
    6: [" ### ",
        "#    ",
