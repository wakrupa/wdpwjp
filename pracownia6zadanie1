        " ### ",
        "#   #",
        " ### "],
    9: [" ### ",
        "#   #",
        " ####",
        "    #",
        " ### "],
}

def pola(cyfra, x, y):
    wynik = set()
    for i in range(5):
        for j in range(5):
            if cyfry[cyfra][i][j] == "#":
                wynik.add((x + i, y + j))
    return wynik

def mozna(cyfra, x, y, mozaika):
    for pole in pola(cyfra, x, y):
        if pole in mozaika:
            return False
    return True
