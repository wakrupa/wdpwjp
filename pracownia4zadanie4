a = 100
b = 10500

def algorytm_erastotenesa(n):
    lista = list(range(n + 1))
    lista[0] = 0
    lista[1] = 0
    for i in range(2, n + 1):
        if lista[i] != 0:
            for j in range(2 * i, n + 1, i):
                lista[j] = 0
    return lista

def palindromy(a, b):
    lista = algorytm_erastotenesa(b)
    lista2 = []
    for i in lista:
        if i != 0 and i >= a and str(i) == str(i)[::-1]:
            lista2.append(i)
    return lista2

wynik = palindromy(a, b)
print(f"Palindromiczne liczby pierwsze z przedziału od {a} do {b} włącznie to: {', '.join(str(x) for x in wynik)}.")
