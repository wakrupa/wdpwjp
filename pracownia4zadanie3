import random
import time

def randperm(n):
    lista = list(range(n)) # list(range(n)) tworzy listę o n miejsch z kolejnymi liczbami od 0 do n-1.
    for i in range(n - 1, 0, -1): # i przybiera kolejne wartości od n - 1 do 1 włącznie (co -1).
        j = random.randint(0, i) # random.randint(a, b) zwraca losową liczbę całkowitą z przedziału od a do b włącznie.
        lista[i], lista[j] = lista[j], lista[i]
    return lista

for i in range(5):
    print(randperm(10))










start = time.time() # time.time() zwraca aktualny czas systemowy.
